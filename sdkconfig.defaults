# SDK 默认配置 for ESP32-C5

# 启用 Bluetooth
CONFIG_BT_ENABLED=y

# NimBLE 配置
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# Observer 角色是 BLE 扫描（ble_gap_disc/ext_disc）所必需的
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# 启用 BLE 5 Extended Advertising / Extended Scanning（BT5 Coded PHY / Long Range）
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_EXT_ADV=y

# 使用外部 PSRAM 分配 NimBLE 内存
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# BLE 控制器配置：确保控制器有足够内存
CONFIG_BT_CTRL_BLE_MAX_ACT=4
CONFIG_BT_CTRL_BLE_MAX_ACT_EFF=4
CONFIG_BT_CTRL_SCAN_DUPL_TYPE=0
CONFIG_BT_CTRL_DUPL_SCAN_CACHE_SIZE=200

# WiFi/BLE 共存（软件共存，ESP32-C5 单天线时分复用）
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_PREFER_BALANCE=y

# 启用 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# lcdfix9：为全屏 DMA 帧缓冲预留更多内部 SRAM（默认 16KB 不够分配 108KB）
# LCD framebuffer 用 heap_caps_malloc(DMA|INTERNAL) 分配，
# 需要确保 SPI DMA pool 足够大
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# ESP32-C5 最低芯片版本（LILYGO T-Display-C5 为 Rev v1.2，需 v1.x）
CONFIG_ESP32C5_REV_MIN_1=y

# 增加主任务栈大小（BLE 需要更多栈空间）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_table/partitionTable.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition_table/partitionTable.csv"

# Flash 配置 (T-Display-C5 有 16MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
