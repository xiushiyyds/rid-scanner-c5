# SDK 默认配置 for ESP32-C5

# 启用 Bluetooth
CONFIG_BT_ENABLED=y

# NimBLE 配置
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# Observer 角色是 BLE 扫描（ble_gap_disc/ext_disc）所必需的
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# 启用 BLE 5 Extended Advertising / Extended Scanning（BT5 Coded PHY / Long Range）
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_EXT_ADV=y

# 使用外部 PSRAM 分配 NimBLE 内存
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# WiFi/BLE 软件共存（ESP32-C5 单天线时分复用，必须开启，否则 BLE 广播可能被 WiFi 抑制）
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# 启用 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# lcdfix9：为全屏 DMA 帧缓冲（108KB）预留更多内部 SRAM，
# 确保 heap_caps_malloc(DMA|INTERNAL) 能成功分配
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# ESP32-C5 最低芯片版本（LILYGO T-Display-C5 为 Rev v1.2，需 v1.x）
CONFIG_ESP32C5_REV_MIN_1=y

# 增加主任务栈大小（BLE 需要更多栈空间）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_table/partitionTable.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition_table/partitionTable.csv"

# Flash 配置 (T-Display-C5 有 16MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
