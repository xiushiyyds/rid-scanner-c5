# SDK 默认配置 for ESP32-C5

# 启用 Bluetooth
CONFIG_BT_ENABLED=y

# NimBLE 配置
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# Observer 角色是 BLE 扫描（ble_gap_disc）所必需的
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# lcdfix19：开启 BLE 5 特性支持
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y

# lcdfix27：关闭 EXT_ADV 以修复 ESP32-C5 BLE controller ext_adv 路径
# r_ble_ll_mem_msys_update assert 崩溃。
#
# 根因（esp-nimble 1.8.0 ble_gap.c:2774-2840 已验证）：
#   当 BLE_EXT_ADV=y 时，ble_gap_adv_start() 内部会自动调用
#   ble_gap_ext_adv_configure() + ble_gap_ext_adv_start()，无论应用层
#   是否直接使用 ext_adv API。C5 controller 在 ext_adv_configure 时
#   内部 mbuf/msys 池分配失败，触发 assert 崩溃（非返回错误码，不可捕获）。
#   即使 legacy_pdu=1 也走同一路径。
#
# 代价：关闭 EXT_ADV 后，ble_gap_ext_disc() 返回 ENOTSUP，无法使用
#   Coded PHY (BT5 Long Range) 扫描。代码 (crid_ble_scan.c) 有完整
#   fallback 到 legacy ble_gap_disc()，覆盖 1M PHY 上所有 ASTM F3411
#   BLE RID 广播（绝大多数 RID 肩灯/无人机使用 1M PHY）。
#   后续 ESP-IDF 修复 C5 controller bug 后可重新启用。
CONFIG_BT_NIMBLE_EXT_ADV=n

# lcdfix27：大幅削减 BLE controller 内存占用，修复 ESP32-C5
# r_ble_ll_mem_msys_update assert 崩溃。
# C5 只有 ~130KB 内部 SRAM，默认 NimBLE 配置预留太多。

# 我们的广播数据 < 32 字节，不需要 1650 字节的大 ADV 缓冲。
# ASTM BLE MessagePack 最大 254 字节，保守设 300 留余量。
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=300

# 只需要 1 个 ext_adv 实例
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=1

# 不需要 2M PHY（只用 1M + Coded PHY/Long Range）
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_2M_PHY=n

# 不需要周期性广播/同步（RID 用的是普通扩展广播）
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV=n
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC=n
CONFIG_BT_NIMBLE_MAX_PERIODIC_SYNCS=0
CONFIG_BT_NIMBLE_MAX_PERIODIC_ADVERTISER_LIST=1

# 只需要 1 个 BLE 连接（单手机控制）
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# 请求更大的 ATT MTU（默认256，512 可让单包 JSON 更少分片）
CONFIG_BT_ATT_PREPARE_COUNT=4
CONFIG_BT_L2CAP_TX_MTU=512
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# 减小 ACL 缓冲区数量（默认24，1连接用不到）
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT_EFF=8
# HCI event 缓冲区（默认30+8）
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARDABLE_COUNT=4

# 减小白名单（默认12）
CONFIG_BT_NIMBLE_WHITELIST_SIZE=4

# Controller 侧配置（esp32c5 特有）
# 减小 resolving list
CONFIG_BT_NIMBLE_LL_RESOLV_LIST_SIZE=4

# msys mbuf 池配置：保持默认（24块128字节 + 24块320字节），
# 过度削减可能影响 controller 正常工作。
# 关键是上面削减 controller 静态内存后，msys 池应该够用。

# lcdfix10：NimBLE 内存改回内部 SRAM。
# 之前放 PSRAM 在 C5 上可能导致 controller 访问延迟/不稳定，
# LCD 帧缓冲已优先占住 108KB 内部 DMA，其余内部 SRAM 对 NimBLE 足够。
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

# WiFi/BLE 软件共存（ESP32-C5 单天线时分复用，必须开启）
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# 启用 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# lcdfix10：LCD 必须在 WiFi/BLE 之前初始化以抢占 108KB 连续 DMA SRAM；
# 此预留值保持 32KB 给其他 DMA 消费者，LCD 自身依赖初始化顺序。
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ESP32-C5 最低芯片版本（LILYGO T-Display-C5 为 Rev v1.2，需 v1.x）
CONFIG_ESP32C5_REV_MIN_1=y

# 主任务栈
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 自定义分区表
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_table/partitionTable.csv"
CONFIG_PARTITION_TABLE_FILENAME="partition_table/partitionTable.csv"

# Flash 配置 (T-Display-C5 有 16MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ================================================================
# v2.0.0-detector: 纯侦测板优化
# ================================================================

# 允许任务栈分配到 PSRAM（非 DMA 任务）
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# WiFi NVS 缓存保持启用
CONFIG_ESP_WIFI_NVS_ENABLED=y

# v2.1.3: WiFi buffer 使用 IDF 默认值，不手动削减。
# IDF v5.5 对 mgmt_sbuf/tx_buf 等有最低值校验，自定义值会导致 init 失败。

# DIO flash 模式（踩坑记录要求）
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# v2.5.10: 回退到默认100Hz tick。
# v2.6.1为模拟器300目标加了1000Hz，但该设置在C5单核上严重影响
# WiFi/BLE共存时序，导致set_channel持续失败、RID收包异常。
# 模拟器3ms帧间隔由frame_interval_ms=3控制，100Hz tick下
# vTaskDelay(3)会退化为10ms，300目标约3s发完，仍在可接受范围。
# 后续若要恢复3ms精度，需用esp_timer或硬件定时器替代vTaskDelay。
# CONFIG_FREERTOS_HZ 不设置，使用IDF默认100Hz。
